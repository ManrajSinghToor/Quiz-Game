# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/quizdb

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP Configuration for Email Verification & Welcome Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Port (Optional for platforms like Render/Railway which set PORT dynamically)
PORT=8080
